{
  "manifest_version": 3,
  "name": "Pulltergeist",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Stacked PRs, no unfinished business. Collapsible stacks in GitHub pull request lists.",
  "permissions": ["storage"],
  "web_accessible_resources": [{
    "resources": ["icons/icon-32.png"],
    "matches": ["https://github.com/*"]
  }],
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["stacks.js", "settings.js", "metadata.js", "view.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
